class ModernButton(ttk.Button):
    def __init__(self, master, **kw):
        super().__init__(master, **kw)
        self.configure(style='Modern.TButton')

class EditableTreeview(ttk.Treeview):
    def __init__(self, master, editable_columns=None, **kw):
        if "selectmode" not in kw:
            kw["selectmode"] = "extended"
        super().__init__(master, **kw)
        self.editing = False
        self.style = ttk.Style()
        self.style.configure("Modern.Treeview", rowheight=30, font=('Segoe UI', 10), background='#ffffff')
        self.style.configure("Modern.Treeview.Heading", font=('Segoe UI', 10, 'bold'),
                             background='#007ACC', foreground='white')
        self.style.map("Modern.Treeview.Heading", background=[('active', '#34495e')])
        self.configure(style='Modern.Treeview')
        self.editable_columns = editable_columns if editable_columns is not None else []
        self.bind("<Double-1>", self.on_double_click)
        self.bind("<Control-ButtonPress-1>", self.on_ctrl_click_start)
        self.bind("<Shift-ButtonPress-1>", self.on_shift_click_start)
        self.bind("<B1-Motion>", self.on_drag)
        self.bind("<ButtonRelease-1>", self.on_drag_release)
        self.drag_selecting = False
        self.drag_action = None
        self.drag_processed = set()
        self.tag_configure('oddrow', background='#f8f9fa')
        self.tag_configure('evenrow', background='#ffffff')

    def on_double_click(self, event):
        region = self.identify_region(event.x, event.y)
        if region != "cell":
            return
        column = self.identify_column(event.x)
        column_index = int(column[1:]) - 1
        if column_index not in self.editable_columns:
            return
        row_id = self.identify_row(event.y)
        if not row_id:
            return
        self.start_edit(row_id, column_index)

    def on_ctrl_click_start(self, event):
        row_id = self.identify_row(event.y)
        if row_id:
            self.selection_add(row_id)
            self.drag_action = "add"
            self.drag_selecting = True
            self.drag_processed = {row_id}
        return "break"

    def on_shift_click_start(self, event):
        row_id = self.identify_row(event.y)
        if row_id:
            self.selection_remove(row_id)
            self.drag_action = "remove"
            self.drag_selecting = True
            self.drag_processed = {row_id}
        return "break"

    def on_drag(self, event):
        if self.drag_selecting:
            row_id = self.identify_row(event.y)
            if row_id and row_id not in self.drag_processed:
                self.drag_processed.add(row_id)
                if self.drag_action == "add":
                    self.selection_add(row_id)
                elif self.drag_action == "remove":
                    self.selection_remove(row_id)

    def on_drag_release(self, event):
        self.drag_selecting = False
        self.drag_action = None
        self.drag_processed = set()

    def start_edit(self, row_id, column_index):
        self.editing = True
        self.selection_set(row_id)
        self.focus(row_id)
        column = f'#{column_index + 1}'
        current_value = self.item(row_id, 'values')[column_index]
        x, y, width, height = self.bbox(row_id, column)
        entry = ttk.Entry(self, font=('Segoe UI', 10))
        entry.place(x=x, y=y, width=width, height=height)
        entry.insert(0, current_value)
        entry.focus_set()
        entry.bind("<Return>", lambda e: self.save_edit(entry, row_id, column_index, True))
        entry.bind("<FocusOut>", lambda e: self.save_edit(entry, row_id, column_index))

    def save_edit(self, entry, row_id, column_index, navigate=False):
        self.editing = False
        new_value = entry.get()
        current_values = list(self.item(row_id, 'values'))
        current_values[column_index] = new_value
        self.item(row_id, values=current_values)
        entry.destroy()
        if navigate:
            next_id = self.next(row_id)
            if next_id:
                self.after(50, lambda: self.start_edit(next_id, column_index))
                self.see(next_id)

class Tooltip:
    def __init__(self, widget, text):
        self.widget = widget
        self.text = text
        self.tooltip = None
        self.widget.bind("<Enter>", self.enter)
        self.widget.bind("<Leave>", self.leave)

    def enter(self, event=None):
        x, y, _, _ = self.widget.bbox("insert")
        x += self.widget.winfo_rootx() + 25
        y += self.widget.winfo_rooty() + 25
        self.tooltip = tk.Toplevel(self.widget)
        self.tooltip.wm_overrideredirect(True)
        self.tooltip.wm_geometry(f"+{x}+{y}")
        label = ttk.Label(self.tooltip, text=self.text, background="#ffffe0", relief="solid", borderwidth=1)
        label.pack()

    def leave(self, event=None):
        if self.tooltip:
            self.tooltip.destroy()
            self.tooltip = None

# --- Funções de Cálculo ---
def calcular_densidade_ar(temperatura_celsius):
    return PRESSAO_ATMOSFERICA / (R_AR * (temperatura_celsius + 273.15))

def calcular_viscosidade_ar(temperatura_celsius):
    T = temperatura_celsius + 273.15
    return MU_0 * (T/T_0)**1.5 * (T_0 + C_SUTHERLAND)/(T + C_SUTHERLAND)

def numero_reynolds(v, D, ρ, μ):
    return (ρ * v * D) / μ

def fator_atrito_haaland(Re, ε, D):
    return (1/(-1.8 * math.log10((ε/(3.7*D))**1.11 + 6.9/Re)))**2

def fator_atrito_sousa_cunha_marques(Re, ε, D):
    return (1/(-2 * math.log10(ε/(3.7*D) - (5.15/Re)*math.log10(ε/(3.7*D) + 5.09/Re**0.87))))**2

def fator_atrito_barr(Re, ε, D):
    f = 0.02
    for _ in range(100):
        f = (1/(-2 * math.log10(ε/(3.7*D) + 5.15/Re**0.87)))**2
    return f

def perda_carga_darcy(ρ, v, D, f):
    return f * (ρ * v**2) / (2 * D)

def diametro_equivalente(h, w):
    return (2 * h * w) / (h + w)

def calcular_velocidade(Q, h, w):
    return Q / (h * w)

def dimensionar_duto(ΔP_min, ΔP_max, temp, Q, metodo, material, w_min, w_max, h_min, h_max, max_ratio, v_max):
    ρ = calcular_densidade_ar(temp)
    μ = calcular_viscosidade_ar(temp)
    ε = RUGOSIDADES.get(material, 0.00003)
    resultados = []
    Q = Q / 3600  # converte de m³/h para m³/s
    for w_mm in range(w_min, w_max + 10, 10):
        w = w_mm / 1000
        for h_mm in range(h_min, min(w_mm, h_max) + 10, 10):
            h = h_mm / 1000
            if max_ratio > 0:
                if h_mm == 0 or w_mm == 0:
                    continue
                ratio = max(w_mm/h_mm, h_mm/w_mm)
                if ratio > max_ratio:
                    continue
            D_eq = diametro_equivalente(h, w)
            v = calcular_velocidade(Q, h, w)
            if v > v_max:
                continue  # descarta se ultrapassar o limitador de velocidade
            Re = numero_reynolds(v, D_eq, ρ, μ)
            if metodo == "Haaland":
                f = fator_atrito_haaland(Re, ε, D_eq)
            elif metodo == "Sousa-Cunha-Marques":
                f = fator_atrito_sousa_cunha_marques(Re, ε, D_eq)
            else:
                f = fator_atrito_barr(Re, ε, D_eq)
            ΔP = perda_carga_darcy(ρ, v, D_eq, f)
            if ΔP_min <= ΔP <= ΔP_max:
                resultados.append((w_mm, h_mm, v, ΔP))
    return resultados

