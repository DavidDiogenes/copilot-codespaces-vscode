    def create_entry(self, parent, label, default, tag):
        frame = ttk.Frame(parent)
        frame.pack(fill=tk.X, padx=5, pady=3)
        ttk.Label(frame, text=label, width=LABEL_WIDTH, anchor=tk.W).pack(side=tk.LEFT)
        entry = ttk.Entry(frame, style='Modern.TEntry', width=ENTRY_WIDTH)
        entry.insert(0, default)
        entry.pack(side=tk.RIGHT, fill=tk.X, expand=True)
        self.entries[tag] = entry
        return entry

    def create_combobox(self, parent, label, values, default_index, width=LABEL_WIDTH, combo_width=ENTRY_WIDTH):
        frame = ttk.Frame(parent)
        frame.pack(fill=tk.X, padx=5, pady=3)
        ttk.Label(frame, text=label, width=width, anchor=tk.W).pack(side=tk.LEFT)
        container = ttk.Frame(frame)
        container.pack(side=tk.RIGHT, fill=tk.X, expand=True)
        combo = ttk.Combobox(container, values=values, style='Modern.TCombobox', width=combo_width)
        combo.current(default_index)
        combo.pack(side=tk.RIGHT, fill=tk.X, expand=True)
        return combo

    def configure_treeview(self, tree, columns):
        for col in columns:
            tree.heading(col, text=col, anchor=tk.CENTER)
            tree.column(col, width=120, anchor=tk.CENTER, stretch=tk.YES)
        vsb = ttk.Scrollbar(tree.master, orient=tk.VERTICAL, command=tree.yview)
        tree.configure(yscrollcommand=vsb.set)
        tree.grid(row=0, column=0, sticky=tk.NSEW)
        vsb.grid(row=0, column=1, sticky=tk.NS)
        tree.master.grid_rowconfigure(0, weight=1)
        tree.master.grid_columnconfigure(0, weight=1)

    def carregar_defaults(self):
        defaults = {
            'vazao': '1000',
            'temp': '25',
            'vel_max': '15',
            'perda_max': '1.3',
            'perda_min': '1.0',
            'w_max': '2000',
            'w_min': '100',
            'h_max': '2000',
            'h_min': '100',
            'max_ratio': '3.0'
        }
        for key, value in defaults.items():
            if key in self.entries:
                self.entries[key].delete(0, tk.END)
                self.entries[key].insert(0, value)

    def calcular(self):
        try:
            parametros = {
                'perda_max': float(self.entries['perda_max'].get()),
                'perda_min': float(self.entries['perda_min'].get()),
                'Q': float(self.entries['vazao'].get()),
                'temp': float(self.entries['temp'].get()),
                'w_max': int(self.entries['w_max'].get()),
                'w_min': int(self.entries['w_min'].get()),
                'h_max': int(self.entries['h_max'].get()),
                'h_min': int(self.entries['h_min'].get()),
                'max_ratio': float(self.entries['max_ratio'].get())
            }
            self.q_value = parametros['Q']
            v_max = float(self.entries['vel_max'].get())
            resultados = dimensionar_duto(
                ΔP_min=parametros['perda_min'],
                ΔP_max=parametros['perda_max'],
                temp=parametros['temp'],
                Q=parametros['Q'],
                metodo=self.metodo.get(),
                material=self.material.get(),
                w_min=parametros['w_min'],
                w_max=parametros['w_max'],
                h_min=parametros['h_min'],
                h_max=parametros['h_max'],
                max_ratio=parametros['max_ratio'],
                v_max=v_max
            )
            self.tree.delete(*self.tree.get_children())
            for res in sorted(resultados, key=lambda x: x[0]):
                self.tree.insert('', 'end', values=(res[0], res[1], f"{res[2]:.2f}", f"{res[3]:.2f}"))
        except ValueError as e:
            messagebox.showerror("Erro de Entrada", f"Valor inválido: {str(e)}")

    def adicionar_selecionado(self):
        for item in self.tree.selection():
            valores = list(self.tree.item(item, 'values'))
            nova_linha = ["", f"{self.q_value}", valores[0], valores[1], valores[2], valores[3]]
            self.tree_selecionados.insert('', 'end', values=nova_linha)

    def remover_selecionado(self):
        for item in list(self.tree_selecionados.selection()):
            self.tree_selecionados.delete(item)

    def trocar_largura_altura(self):
        selecionados = self.tree_selecionados.selection()
        for item in selecionados:
            valores = list(self.tree_selecionados.item(item, 'values'))
            valores[2], valores[3] = valores[3], valores[2]
            self.tree_selecionados.item(item, values=valores)

    def mover_para_cima(self):
        selecionados = self.tree_selecionados.selection()
        for item in selecionados:
            index = self.tree_selecionados.index(item)
            if index > 0:
                self.tree_selecionados.move(item, '', index-1)

    def mover_para_baixo(self):
        selecionados = self.tree_selecionados.selection()
        for item in reversed(selecionados):
            index = self.tree_selecionados.index(item)
            if index < len(self.tree_selecionados.get_children())-1:
                self.tree_selecionados.move(item, '', index+1)

    def handle_enter(self, event):
        if self.tree_selecionados.editing:
            return
        selected = self.tree_selecionados.selection()
        if not selected:
            return
        row_id = selected[0]
        editable_columns = self.tree_selecionados.editable_columns
        if not editable_columns:
            return
        column_index = editable_columns[0]
        self.tree_selecionados.start_edit(row_id, column_index)
        return "break"

    def handle_tab_press(self, event):
        self.trocar_largura_altura()
        return 'break'

    def on_middle_press(self, event):
        self._drag_start_y = event.y
        self._last_drag_y = event.y
        self._accumulated_delta = 0

    def on_middle_drag(self, event):
        if not hasattr(self, '_drag_start_y'):
            return
        current_y = event.y
        delta = current_y - self._last_drag_y
        self._last_drag_y = current_y
        self._accumulated_delta += delta
        threshold = 30
        while self._accumulated_delta <= -threshold:
            self.mover_para_cima()
            self._accumulated_delta += threshold
        while self._accumulated_delta >= threshold:
            self.mover_para_baixo()
            self._accumulated_delta -= threshold

    def on_middle_release(self, event):
        if hasattr(self, '_drag_start_y'):
            del self._drag_start_y
            del self._last_drag_y
            del self._accumulated_delta

    def salvar(self):
        if self.current_file:
            try:
                with open(self.current_file, 'w', newline='', encoding='utf-8') as f:
                    writer = csv.writer(f, delimiter=';')
                    writer.writerow(['Trecho', 'Vazão (m³/h)', 'Largura (mm)', 'Altura (mm)', 'Velocidade (m/s)', 'Fricção (Pa/m)'])
                    for item in self.tree_selecionados.get_children():
                        writer.writerow(self.tree_selecionados.item(item, 'values'))
                messagebox.showinfo("Sucesso", "Dados salvos com sucesso!")
            except Exception as e:
                messagebox.showerror("Erro", f"Falha ao salvar arquivo:\n{str(e)}")
        else:
            self.salvar_como()

    def salvar_como(self):
        filename = filedialog.asksaveasfilename(defaultextension=".csv", filetypes=[("Arquivos CSV", "*.csv")])
        if filename:
            self.current_file = filename
            self.salvar()

    def importar_csv(self):
        filename = filedialog.askopenfilename(filetypes=[("Arquivos CSV", "*.csv")])
        if filename:
            try:
                with open(filename, 'r', newline='', encoding='utf-8') as f:
                    reader = csv.reader(f, delimiter=';')
                    next(reader)
                    self.tree_selecionados.delete(*self.tree_selecionados.get_children())
                    for row in reader:
                        if len(row) == 6:
                            formatted_row = [
                                row[0],
                                f"{float(row[1]):.2f}",
                                f"{int(float(row[2]))}",
                                f"{int(float(row[3]))}",
                                f"{float(row[4]):.2f}",
                                f"{float(row[5]):.2f}"
                            ]
                            self.tree_selecionados.insert('', 'end', values=formatted_row)
                messagebox.showinfo("Sucesso", "Dados importados com sucesso!")
            except Exception as e:
                messagebox.showerror("Erro", f"Falha ao importar arquivo:\n{str(e)}")

    def mover_para_cima_tecla(self, event):
        current_selection = self.tree_selecionados.selection()
        if not current_selection:
            children = self.tree_selecionados.get_children()
            if children:
                self.tree_selecionados.selection_set(children[0])
                self.tree_selecionados.focus(children[0])
            return
        current_item = current_selection[0]
        prev_item = self.tree_selecionados.prev(current_item)
        if prev_item:
            self.tree_selecionados.selection_set(prev_item)
            self.tree_selecionados.focus(prev_item)
        return "break"

    def mover_para_baixo_tecla(self, event):
        current_selection = self.tree_selecionados.selection()
        if not current_selection:
            children = self.tree_selecionados.get_children()
            if children:
                self.tree_selecionados.selection_set(children[0])
                self.tree_selecionados.focus(children[0])
            return
        current_item = current_selection[0]
        next_item = self.tree_selecionados.next(current_item)
        if next_item:
            self.tree_selecionados.selection_set(next_item)
            self.tree_selecionados.focus(next_item)
        return "break"

    def deletar_linha(self, event):
        for item in list(self.tree_selecionados.selection()):
            self.tree_selecionados.delete(item)

    def gerar_planilha_personalizada(self):
        filename = filedialog.asksaveasfilename(defaultextension=".xlsx", filetypes=[("Arquivos Excel", "*.xlsx")])
        if not filename:
            return
        try:
            wb = Workbook()
            ws = wb.active
            ws.title = "Resultados Escolhidos"

            # Estilo unificado para cabeçalhos
            header_font = Font(bold=True, color="FFFFFF", name="Calibri", size=11)
            header_fill = PatternFill(start_color="007ACC", end_color="007ACC", fill_type="solid")
            # Estilo para os valores dos parâmetros e dos resultados: fundo branco, texto preto
            value_font = Font(bold=False, color="000000", name="Calibri", size=11)
            data_fill = PatternFill(start_color="FFFFFF", end_color="FFFFFF", fill_type="solid")
            alignment = Alignment(horizontal="center", vertical="center")
            thin_border = Border(left=Side(style='thin'), right=Side(style='thin'),
                                 top=Side(style='thin'), bottom=Side(style='thin'))

            params = {
                "Vazão (m³/h):": self.entries['vazao'].get(),
                "Temperatura (°C):": self.entries['temp'].get(),
                "Velocidade Limite (m/s):": self.entries['vel_max'].get(),
                "Fricção Máxima (Pa/m):": self.entries['perda_max'].get(),
                "Fricção Mínima (Pa/m):": self.entries['perda_min'].get(),
                "Material do Duto:": self.material.get(),
                "Fator de Atrito:": self.metodo.get()
            }
            row_idx = 1
            ws.column_dimensions['A'].width = 30
            ws.column_dimensions['B'].width = 18
            for key, val in params.items():
                cell_key = ws.cell(row=row_idx, column=1, value=key)
                cell_key.font = header_font
                cell_key.fill = header_fill
                cell_key.alignment = alignment
                cell_key.border = thin_border

                try:
                    num = float(val)
                    val_formatted = f"{num:.2f}".replace('.', ',')
                except:
                    val_formatted = str(val)
                cell_val = ws.cell(row=row_idx, column=2, value=val_formatted)
                cell_val.font = value_font
                cell_val.fill = data_fill
                cell_val.alignment = alignment
                cell_val.border = thin_border
                row_idx += 1

            row_idx += 1  # Linha em branco

            # Cabeçalho dos resultados
            headers = ['Trecho', 'Vazão (m³/h)', 'Largura (mm)', 'Altura (mm)', 'Velocidade (m/s)', 'Fricção (Pa/m)', 'Comprimento (m)', 'Perda (Pa)']
            for col_num, header_text in enumerate(headers, start=1):
                cell = ws.cell(row=row_idx, column=col_num, value=header_text)
                cell.font = header_font
                cell.fill = header_fill
                cell.alignment = alignment
                cell.border = thin_border
                ws.column_dimensions[cell.column_letter].width = 18

            def format_decimal(val):
                try:
                    num = float(val)
                    return f"{num:.2f}".replace('.', ',')
                except:
                    return str(val)

            # Preenche os resultados a partir da linha seguinte
            for r, item in enumerate(self.tree_selecionados.get_children(), start=row_idx+1):
                valores = list(self.tree_selecionados.item(item, 'values'))
                nova_linha = valores[:5] + [valores[5]] + ["", ""]
                for col_idx, value in enumerate(nova_linha, start=1):
                    cell = ws.cell(row=r, column=col_idx, value=format_decimal(value))
                    cell.font = value_font
                    cell.fill = data_fill
                    cell.alignment = alignment
                    cell.border = thin_border

            wb.save(filename)
            messagebox.showinfo("Sucesso", "Planilha personalizada gerada com sucesso!")
        except Exception as e:
            messagebox.showerror("Erro", f"Falha ao gerar planilha:\n{str(e)}")

    def center_window(self):
        self.update_idletasks()
        width = self.winfo_width()
        height = self.winfo_height()
        x = (self.winfo_screenwidth() // 2) - (width // 2)
        y = (self.winfo_screenheight() // 2) - (height // 2)
        self.geometry(f'{width}x{height}+{x}+{y}')

    def adicionar_watermark(self):
        self.watermark = ttk.Label(self, text="⚙️ DuctFlow 1.0 | David Diogenes ®",
                                     style='Watermark.TLabel', font=('Segoe UI', 8),
                                     foreground='#888888', anchor='e')
        self.watermark.place(relx=1, rely=1, anchor='se')

    def on_closing(self):
        if messagebox.askyesno("Confirmação", "Deseja salvar o arquivo antes de fechar?"):
            self.salvar()
        self.destroy()

