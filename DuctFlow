# Constantes físicas
PRESSAO_ATMOSFERICA = 101325
R_AR = 287.05
MU_0 = 1.716e-5
T_0 = 273.15
C_SUTHERLAND = 110.4

# Dados de rugosidade e métodos de atrito
RUGOSIDADES = {
    "Aço carbono (Não Revestido)": 0.00003,
    "PVC": 0.00003,
    "Alumínio": 0.00003,
    "Aço Galvanizado (Costuras em Espiral)": 0.00009,
    "Aço Galvanizado (Imersão a Quente)": 0.00015,
    "Fibra de Vidro (Rígido)": 0.0009,
    "Fibra de Vidro (Revestido)": 0.0009,
    "Fibra de Vidro (Spray)": 0.003,
    "Duto Metálico Flexível": 0.003,
    "Duto Flexível (Tecido e Fio)": 0.003,
    "Concreto": 0.003
}

FATORES_ATRITO = ["Haaland", "Sousa-Cunha-Marques", "Barr"]

# Constantes para padronização dos tamanhos dos campos
LABEL_WIDTH = 25   # Tamanho fixo para os rótulos
ENTRY_WIDTH = 25   # Tamanho fixo para os campos de entrada

